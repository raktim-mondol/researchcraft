## Required — your LLM endpoint

# OpenAI-compatible base URL (must include the /v1 path if the provider uses it).
# Examples:
#   https://api.openai.com/v1
#   https://api.anthropic.com/v1          (via a compatible proxy)
#   http://localhost:11434/v1            (Ollama OpenAI-compat)
#   https://openrouter.ai/api/v1
LLM_BASE_URL=

# Bearer API key for the endpoint above. Optional for some local servers
# (e.g. Ollama) that ignore auth.
LLM_API_KEY=

# Model id the endpoint expects (e.g. gpt-4o, claude-sonnet-4, llama3.2).
LLM_MODEL=

# Context window in tokens (session meter + compaction budget). Set this to the
# real limit from your model docs / OpenRouter context_length. If unset, defaults
# to 1000000 (1M). Examples: 128000, 200000, 1048576.
# LLM_CONTEXT_WINDOW=1000000

# Vision: set true when the model accepts image blocks (e.g. gpt-4o, claude,
# gemini). Leave unset/false for text-only models — image attachments are then
# rejected with a clear error instead of being silently dropped.
# LLM_MULTIMODAL=false

# Optional pricing in USD per 1M tokens. When set, the cost meters and the
# project spend cap are computed from token usage even if the provider reports
# no usage cost. Leave unset to track only what the provider reports.
# LLM_PRICE_INPUT=0.28
# LLM_PRICE_OUTPUT=0.42
# LLM_PRICE_CACHE_READ=0.028


## Optional: image generation (agent tool `image_generate`)

# Separate from the chat LLM above (chat may be Qwen/Ollama/etc.).
# Set IMAGE_MODEL to enable. Open a new chat tab after changing.
#
# OpenAI GPT Image / DALL·E — requires its own Images endpoint + key:
# IMAGE_MODEL=gpt-image-2
# IMAGE_PROVIDER=openai
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=sk-...
#
# Gemini Nano Banana — uses GEMINI_API_KEY (or IMAGE_API_KEY):
# IMAGE_MODEL=gemini-3.1-flash-image
#   # or gemini-3.1-flash-lite-image | gemini-3-pro-image | gemini-2.5-flash-image
# IMAGE_PROVIDER=gemini
# (also set GEMINI_API_KEY below)


## Optional: web access (pi-web-access)

# Web search, URL/PDF fetching, GitHub repo reading, and video understanding
# work out of the box with no key (Exa MCP fallback). Add keys to unlock the
# direct providers — they can also be set live from Settings → API keys.
# EXA_API_KEY=            # exa.ai — fast web + code search
# PERPLEXITY_API_KEY=     # perplexity.ai — synthesized answers with citations
# GEMINI_API_KEY=         # Google AI Studio — search fallback + YouTube/video understanding


## Optional: Parallel Search MCP + Firecrawl MCP

# Seeded into every project as MCP connectors (Settings → Connectors). Both
# work keyless on free tiers; keys raise rate limits and unlock more Firecrawl
# tools. Can also be set live from Settings → API keys.
# PARALLEL_API_KEY=       # platform.parallel.ai — Parallel Search MCP
# FIRECRAWL_API_KEY=      # firecrawl.dev — scrape / crawl / extract MCP

# Scientific literature (Scite + Consensus) uses OAuth, not API keys.
# Sign in from Settings → Connectors. Tokens are stored in .mcp-oauth/.


## Optional: backend knobs

# Override the backend port / projects directory if needed.
# KADY_PORT=8000
# KADY_PROJECTS_ROOT=./projects
# Python interpreter used only for the scientific preview helpers.
# KADY_PYTHON=python3


## Optional: Modal remote compute

# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=


## Not used yet — being re-added as native tools

# The integrations below were part of the previous architecture and are not
# read by the current backend. They're listed here so you don't lose your
# values; literature search and document conversion will return as native
# tools in upcoming releases. (Web search/scrape is back — see the web access
# and Parallel/Firecrawl sections above. Modal is live under its own section.)

# Paperclip literature / regulatory / clinical-trial search
# PAPERCLIP_API_KEY=

# Scientific databases and search
# NCBI_API_KEY=
# NCBI_EMAIL=
# S2_API_KEY=
# CORE_API_KEY=
# OPENALEX_API_KEY=

# Specialized scientific APIs
# ADAPTYV_API_KEY=
# ROWAN_API_KEY=
# MP_API_KEY=
# OMIM_API_KEY=
# BIOGRID_API_KEY=
# DISGENET_API_KEY=
# ADDGENE_API_KEY=
# CLUE_API_KEY=
# OPENFDA_API_KEY=
# PATENTSVIEW_API_KEY=
# DATACOMMONS_API_KEY=

# Government / economic data
