{
  "name": "@deepseek-ai/dsh-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the DeepSeek Harness filesystem seam (ctx.fs)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@deepseek-ai/schemastery": "file:../schemastery"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": "file:../dsh-attachment",
    "@deepseek-ai/dsh-fs": "file:../dsh-fs",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-sandbox": "file:../dsh-sandbox",
    "@deepseek-ai/dsh-sandbox-policy": "file:../dsh-sandbox-policy",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/dsh-user-approval": "file:../dsh-user-approval",
    "@deepseek-ai/cordis": "file:../cordis"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-agent-loop": "file:../dsh-agent-loop",
    "@deepseek-ai/dsh-agent-loop-testkit": "file:../dsh-agent-loop-testkit",
    "@deepseek-ai/dsh-attachment": "file:../dsh-attachment",
    "@deepseek-ai/dsh-fs": "file:../dsh-fs",
    "@deepseek-ai/dsh-fs-local": "file:../dsh-fs-local",
    "@deepseek-ai/dsh-fs-observation-policy": "file:../dsh-fs-observation-policy",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-llm-deepseek": "file:../dsh-llm-deepseek",
    "@deepseek-ai/dsh-sandbox": "file:../dsh-sandbox",
    "@deepseek-ai/dsh-sandbox-policy": "file:../dsh-sandbox-policy",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/dsh-user-approval": "file:../dsh-user-approval",
    "@deepseek-ai/cordis": "file:../cordis"
  }
}
