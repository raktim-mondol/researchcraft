{
  "name": "@deepseek-ai/dsh-agent-loop",
  "description": "The concrete agent loop plugin for the DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/agent-loop"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-scope": "file:../dsh-scope",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-session-persistence": "file:../dsh-session-persistence",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/cordis": "file:../cordis",
    "@deepseek-ai/dsh-settings": "file:../dsh-settings"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "file:../schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-scope": "file:../dsh-scope",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-session-persistence": "file:../dsh-session-persistence",
    "@deepseek-ai/dsh-session-persistence-jsonl": "file:../dsh-session-persistence-jsonl",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/cordis": "file:../cordis",
    "@deepseek-ai/dsh-settings": "file:../dsh-settings"
  }
}
