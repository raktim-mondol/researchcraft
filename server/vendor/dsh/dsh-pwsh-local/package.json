{
  "name": "@deepseek-ai/dsh-pwsh-local",
  "description": "Local PowerShell implementation of the DeepSeek Harness bash executor seam",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/pwsh-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-shell": "file:../dsh-shell",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-subprocess": "file:../dsh-subprocess",
    "@deepseek-ai/dsh-timeout": "file:../dsh-timeout",
    "@deepseek-ai/cordis": "file:../cordis",
    "@deepseek-ai/dsh-settings": "file:../dsh-settings"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "file:../schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-shell": "file:../dsh-shell",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-subprocess": "file:../dsh-subprocess",
    "@deepseek-ai/dsh-subprocess-local": "file:../dsh-subprocess-local",
    "@deepseek-ai/dsh-timeout": "file:../dsh-timeout",
    "@deepseek-ai/cordis": "file:../cordis",
    "@deepseek-ai/dsh-settings": "file:../dsh-settings"
  }
}
