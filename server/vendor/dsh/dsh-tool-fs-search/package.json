{
  "name": "@deepseek-ai/dsh-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@deepseek-ai/schemastery": "file:../schemastery"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-output-retention": "file:../dsh-output-retention",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-spill": "file:../dsh-spill",
    "@deepseek-ai/dsh-subprocess": "file:../dsh-subprocess",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-timeout": "file:../dsh-timeout",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/cordis": "file:../cordis"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-subprocess": "file:../dsh-subprocess",
    "@deepseek-ai/dsh-subprocess-local": "file:../dsh-subprocess-local",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-output-retention": "file:../dsh-output-retention",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-spill": "file:../dsh-spill",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-timeout": "file:../dsh-timeout",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/cordis": "file:../cordis"
  }
}
