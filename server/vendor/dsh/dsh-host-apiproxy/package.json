{
  "name": "@deepseek-ai/dsh-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-attachment": "file:../dsh-attachment",
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-agent-default-model": "file:../dsh-agent-default-model",
    "@deepseek-ai/dsh-api-remotes": "file:../dsh-api-remotes",
    "@deepseek-ai/dsh-brand": "file:../dsh-brand",
    "@deepseek-ai/dsh-commands": "file:../dsh-commands",
    "@deepseek-ai/dsh-credentials": "file:../dsh-credentials",
    "@deepseek-ai/dsh-goal": "file:../dsh-goal",
    "@deepseek-ai/dsh-host-directory-picker": "file:../dsh-host-directory-picker",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-native-command": "file:../dsh-native-command",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-session-persistence": "file:../dsh-session-persistence",
    "@deepseek-ai/dsh-session-projection": "file:../dsh-session-projection",
    "@deepseek-ai/dsh-session-projection-cache": "file:../dsh-session-projection-cache",
    "@deepseek-ai/dsh-session-query": "file:../dsh-session-query",
    "@deepseek-ai/dsh-session-title": "file:../dsh-session-title",
    "@deepseek-ai/dsh-settings": "file:../dsh-settings",
    "@deepseek-ai/dsh-skill": "file:../dsh-skill",
    "@deepseek-ai/dsh-subagent": "file:../dsh-subagent",
    "@deepseek-ai/dsh-jobs": "file:../dsh-jobs",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/dsh-user-approval": "file:../dsh-user-approval",
    "@deepseek-ai/dsh-user-questions": "file:../dsh-user-questions",
    "@deepseek-ai/dsh-workspace": "file:../dsh-workspace",
    "@deepseek-ai/schemastery": "file:../schemastery",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "file:../cordis",
    "@deepseek-ai/dsh-agent-presets": "file:../dsh-agent-presets",
    "@deepseek-ai/dsh-cordis-host-runner": "file:../dsh-cordis-host-runner",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../cordis",
    "@deepseek-ai/dsh-agent-presets": "file:../dsh-agent-presets",
    "@deepseek-ai/dsh-cordis-host-runner": "file:../dsh-cordis-host-runner",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-storage": "file:../dsh-storage",
    "@deepseek-ai/dsh-storage-domain": "file:../dsh-storage-domain",
    "@deepseek-ai/dsh-typert-protocol": "file:../dsh-typert-protocol",
    "@deepseek-ai/dsh-typert-registry": "file:../dsh-typert-registry"
  }
}
