    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-compaction": "file:../dsh-compaction",
    "@deepseek-ai/dsh-commands": "file:../dsh-commands",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-token-meter": "file:../dsh-token-meter",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "file:../dsh-compaction-tool-result-pruner",
    "@deepseek-ai/cordis": "file:../cordis"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "file:../schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "file:../cordis-plugin-include",
    "@deepseek-ai/cordis-plugin-loader": "file:../cordis-plugin-loader",
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-agent-loop": "file:../dsh-agent-loop",
    "@deepseek-ai/dsh-agent-loop-testkit": "file:../dsh-agent-loop-testkit",
    "@deepseek-ai/dsh-compaction": "file:../dsh-compaction",
    "@deepseek-ai/dsh-commands": "file:../dsh-commands",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-llm-retry": "file:../dsh-llm-retry",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-token-meter": "file:../dsh-token-meter",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "file:../dsh-compaction-tool-result-pruner",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/cordis": "file:../cordis"
  }
}
