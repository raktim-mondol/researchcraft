{
  "name": "@deepseek-ai/dsh-subagent-in-process-driver",
  "description": "Shared in-process subagent run driver: drives a child agent on ctx.agents (used by the spawn and fork backends)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-in-process-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-subagent": "file:../dsh-subagent",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/cordis": "file:../cordis"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "file:../cordis-plugin-include",
    "@deepseek-ai/cordis-plugin-loader": "file:../cordis-plugin-loader",
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-agent-loop": "file:../dsh-agent-loop",
    "@deepseek-ai/dsh-agent-loop-testkit": "file:../dsh-agent-loop-testkit",
    "@deepseek-ai/dsh-agent-presets": "file:../dsh-agent-presets",
    "@deepseek-ai/dsh-fs-sandbox": "file:../dsh-fs-sandbox",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-sandbox-policy": "file:../dsh-sandbox-policy",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-subagent": "file:../dsh-subagent",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-tool-fs": "file:../dsh-tool-fs",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/dsh-user-approval": "file:../dsh-user-approval",
    "@deepseek-ai/cordis": "file:../cordis"
  }
}
