{
  "name": "@deepseek-ai/dsh-tool-bash",
  "description": "Model-facing bash tool with optional generic background-job and sandbox-escalation support",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/shell/tool-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-shell": "file:../dsh-shell",
    "@deepseek-ai/dsh-shell-env": "file:../dsh-shell-env",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-sandbox": "file:../dsh-sandbox",
    "@deepseek-ai/dsh-sandbox-policy": "file:../dsh-sandbox-policy",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-jobs": "file:../dsh-jobs",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/dsh-user-approval": "file:../dsh-user-approval",
    "@deepseek-ai/cordis": "file:../cordis"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "file:../schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "file:../dsh-agent",
    "@deepseek-ai/dsh-agent-loop": "file:../dsh-agent-loop",
    "@deepseek-ai/dsh-agent-loop-testkit": "file:../dsh-agent-loop-testkit",
    "@deepseek-ai/dsh-shell": "file:../dsh-shell",
    "@deepseek-ai/dsh-shell-env": "file:../dsh-shell-env",
    "@deepseek-ai/dsh-bash-local": "file:../dsh-bash-local",
    "@deepseek-ai/dsh-invariants": "file:../dsh-invariants",
    "@deepseek-ai/dsh-llm": "file:../dsh-llm",
    "@deepseek-ai/dsh-subprocess-local": "file:../dsh-subprocess-local",
    "@deepseek-ai/dsh-sandbox": "file:../dsh-sandbox",
    "@deepseek-ai/dsh-sandbox-policy": "file:../dsh-sandbox-policy",
    "@deepseek-ai/dsh-session": "file:../dsh-session",
    "@deepseek-ai/dsh-session-persistence-jsonl": "file:../dsh-session-persistence-jsonl",
    "@deepseek-ai/dsh-system-prompt": "file:../dsh-system-prompt",
    "@deepseek-ai/dsh-jobs": "file:../dsh-jobs",
    "@deepseek-ai/dsh-jobs-local": "file:../dsh-jobs-local",
    "@deepseek-ai/dsh-tool-jobs": "file:../dsh-tool-jobs",
    "@deepseek-ai/dsh-tools": "file:../dsh-tools",
    "@deepseek-ai/dsh-user-approval": "file:../dsh-user-approval",
    "@deepseek-ai/cordis": "file:../cordis"
  }
